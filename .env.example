ROS_DOMAIN_ID=10
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
HAR_ROBOT_NAMESPACE=rosbot_1
HAR_VPOCLIP_ROBOT_NAMESPACES=rosbot_1,rosbot_2
HAR_ENABLE_VIEW_POLICY=1
# Leave these empty to use vpoclip_config.csv. Set explicitly for a one-off
# override (start_vpoclip.sh always forces HAR_DISPLAY=1).
HAR_ENABLE_FOLLOW=
HAR_DISPLAY=
HAR_VIEW_SELECTION_MODE=rl
HAR_VIEW_RANDOM_SEED=20260915
HAR_VIEW_BASELINE_HOLD_SECONDS=3.0
HAR_RUNTIME_DEVICE=
HAR_RECOGNIZER_RTMPOSE_DEVICE=
HAR_VPOCLIP_RTMPOSE_DEVICE=
HAR_VPOCLIP_START_TIMEOUT_SEC=120
HAR_VIEW_RTMPOSE_DEVICE=cpu
HAR_POLICY_DEVICE=cuda
HAR_VIEW_POLICY_RATE_HZ=1.0
HAR_ROS_WAIT_TIMEOUT=
HAR_IMAGE_TRANSPORT=
HAR_ROS_QOS_RELIABILITY=
HAR_VIEW_TOPICS=/rosbot_1/camera/rgb/image_raw/compressed,/rosbot_2/camera/rgb/image_raw/compressed,/har/view/slot_2/compressed,/har/view/slot_3/compressed
# PERSON_FOLLOW_WS=/home/youhan/HAR/person_follow_ws
